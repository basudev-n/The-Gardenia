{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/build"
      }
    },
    {
      "src": "frontend/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/frontend/api/$1" },
    { "src": "/(.*)", "dest": "/frontend/build/$1" },
    { "src": "^/$", "dest": "/frontend/build/index.html" }
  ]
}
