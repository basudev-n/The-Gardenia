{
  "version": 2,
  "public": false,
  "builds": [
    {
      "src": "frontend/build",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/frontend/api/$1"
    },
    {
      "src": "^/static/(.*)",
      "dest": "/frontend/build/static/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/frontend/build/index.html"
    },
    {
      "src": "^/$",
      "dest": "/frontend/build/index.html"
    }
  ]
}
