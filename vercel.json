{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "frontend/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/frontend/api/$1" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "^/(?!api|static).*$", "dest": "/index.html" },
    { "src": "^/$", "dest": "/index.html" }
  ]
}
