{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/build",
  "builds": [
    {
      "src": "frontend/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/frontend/api/$1" },
    { "src": "/static/(.*)", "dest": "/frontend/build/static/$1" },
    { "src": "^/(.*)$", "dest": "/frontend/build/$1" },
    { "src": "^/$", "dest": "/frontend/build/index.html" }
  ]
}
